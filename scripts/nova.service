[Unit]
Description=NOVA Personal AI Wearable Computer
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Nova-Project
ExecStart=/home/pi/Nova-Project/venv/bin/python /home/pi/Nova-Project/software/nova/main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
