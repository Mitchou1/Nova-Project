{
    "device_name": "NOVA",
    "version": "0.1.0",
    "screen": {
        "width": 800,
        "height": 480,
        "rotation": 0
    },
    "theme": "cyberpunk",
    "language": "en",
    "wifi": {
        "auto_connect": true
    },
    "power": {
        "low_battery_threshold": 15,
        "auto_sleep_minutes": 5
    },
    "audio": {
        "volume": 100,
        "brightness": 100
    },
    "ui": {
        "particles": "auto",
        "waveform": "auto",
        "animations": "auto",
        "transition": "auto"
    },
    "map": {
        "provider": "local",
        "style": "basic-preview",
        "api_key": "",
        "online": true,
        "allow_online_fallback": false,
        "local_url": "http://localhost:8080/styles/nova-streets/{z}/{x}/{y}.png"
    },
    "ai": {
        "whisper_model": "small",
        "llm_model": "qwen2.5-3b-instruct-q5_k_m.gguf",
        "tts_voice": "fr_FR-siwis-medium.onnx"
    },
    "gods_eye": {
        "enabled": true,
        "install_path": "~/nova2/external/gods-eye-view",
        "port": 4173,
        "auto_stop_on_exit": true,
        "startup_timeout": 120,
        "zoom": 1.5,
        "tactile": true
    },
    "bluetooth_enabled": false,
    "notifications": true,
    "power_saving": true
}
